{
  "name": "basicagent",
  "version": "1.3.7",
  "description": "A small, dependency-free command line agent with file tools, skills and OpenAI-compatible LLM providers.",
  "type": "module",
  "bin": {
    "basicagent": "bin/basicagent.mjs",
    "basicagent-web": "bin/basicagent-web.mjs",
    "basicagent-setup": "bin/basicagent-setup.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:live": "node --test test/live/*.test.mjs",
    "web": "node bin/basicagent-web.mjs",
    "setup": "node bin/basicagent-setup.mjs"
  },
  "keywords": [
    "agent",
    "cli",
    "ollama",
    "openai-compatible",
    "tools"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/henksys/basicagent.git"
  },
  "license": "GPL-3.0-or-later",
  "private": true
}
